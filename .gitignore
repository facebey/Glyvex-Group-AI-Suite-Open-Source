# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/
frontend/node_modules/
vite.config.js.timestamp-*.mjs

# Build
frontend/dist/
# Artefactos PyInstaller (sidecar Tauri, T-1): los genera build.ps1
backend/build/
backend/dist/
# Junction que apunta a backend/dist/glyvex-backend (la crea build.ps1):
# sin ella el resource se instala bajo _up_/backend/dist/ y el sidecar no resuelve
src-tauri/resources/glyvex-backend/

# Tauri updater (T6): clave ed25519 de firma. La PRIVADA (glyvex.key) NUNCA
# se commitea ni sube; la pública (su contenido) vive en tauri.conf.json.
.tauri/

# Variante local de build (endpoint 127.0.0.1:9735 + bump de versión): solo en disco.
# El override versionado es tauri.update-local.conf.json (no versionar duplicados del config completo)
src-tauri/tauri.update-local-full.conf.json

# Documentacion local puntual (solo en disco)
REVIEW_PLAN.md

# Distribucion (clone local del repo open source; la crea sync-oss)
distribution/oss-clone/
# Brand kit: el zip se guarda en Files (fuente de verdad: la carpeta extraida)
assets/brand.zip

# Data / logs (no commitear datos locales)
# Instancias alternativas: environments/<nombre>.env define GLYVEX_DATA_DIR,
# y por convención esos directorios se llaman data-<algo> (data-testing, etc).
data-*/
data/config.json
data/models.json
data/models_schema_version.json
data/attachments/
data/logs/
data/benchmarks/
data/runtime/
data/*.db
data/*.db-shm
data/*.db-wal
backend-prod.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Documentacion local (solo en disco, no versionar)
AGENTS.md
src-tauri/tauri.release-build.conf.json
