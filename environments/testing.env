# testing.env — Instancia de testing de Glyvex-AI-Suite.
#
# Corre en paralelo con producción, en la misma máquina, sin compartir NADA:
# puertos distintos y su propio GLYVEX_DATA_DIR. Ver production.env para las
# reglas del formato.
#
# ---------------------------------------------------------------------------
# PARA CAMBIAR LOS PUERTOS DE ESTA INSTANCIA, TOCÁ SOLO ESTE ARCHIVO.
#
# Son cuatro líneas que tienen que moverse juntas:
#   GLYVEX_PORT          -> backend (uvicorn)
#   GLYVEX_DEV_PORT      -> dev server de Vite
#   GLYVEX_CORS_ORIGINS  -> debe listar el GLYVEX_DEV_PORT de arriba
# El proxy /api del frontend NO se configura aparte: vite.config.js lee este
# mismo archivo y arma el destino con GLYVEX_HOST y GLYVEX_PORT.
# ---------------------------------------------------------------------------

GLYVEX_ENV=testing

# Backend (uvicorn)
GLYVEX_HOST=127.0.0.1
GLYVEX_PORT=22222

# Dev server de Vite (npm run dev -- --mode testing)
GLYVEX_DEV_PORT=25173

# Estado separado: nada de esta instancia toca el ./data de producción.
GLYVEX_DATA_DIR=./data-testing

GLYVEX_CORS_ORIGINS=http://localhost:25173,http://127.0.0.1:25173
