# production.env — Instancia de producción de Glyvex-AI-Suite.
#
# Texto plano KEY=value. Lo leen los scripts start.sh / start.cmd / start.ps1
# (que exportan cada línea como variable de entorno antes de arrancar uvicorn)
# y también frontend/vite.config.js, que parsea este mismo archivo para sacar
# el puerto del dev server y el destino del proxy.
#
# Reglas del formato (las tres implementaciones se comportan igual):
#   - una asignación por línea, KEY=value
#   - líneas vacías y las que empiezan con # se ignoran
#   - los espacios alrededor de = se recortan
#   - NO hay expansión de variables ni comillas mágicas: el valor se toma
#     literal (si escribís comillas, quedan dentro del valor)
#
# Para mover esta instancia de puerto, cambiá GLYVEX_PORT y GLYVEX_DEV_PORT
# acá y listo: el backend, el proxy del frontend y el CORS quedan alineados
# solos. Ojo con GLYVEX_CORS_ORIGINS, que tiene que incluir el dev port.

# Nombre del entorno. Solo informativo: aparece en el log de arranque y en
# /api/health para poder distinguir de un vistazo qué instancia estás mirando.
GLYVEX_ENV=production

# Backend (uvicorn)
GLYVEX_HOST=127.0.0.1
GLYVEX_PORT=7981

# Dev server de Vite (npm run dev). No lo usa el backend.
GLYVEX_DEV_PORT=5173

# Estado de ESTA instancia: config.json, glyvex.db, metrics.db, attachments/,
# logs/, benchmarks/, templates/. Relativo se resuelve contra la raíz del
# repo; también acepta una ruta absoluta (/var/lib/glyvex/data).
GLYVEX_DATA_DIR=./data

# Orígenes permitidos por CORS, separados por comas. Tiene que incluir el
# dev server de Vite de esta instancia (GLYVEX_DEV_PORT).
GLYVEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
